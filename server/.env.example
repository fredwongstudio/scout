# Server-only configuration. Do not put these values in VITE_* variables.
OPENAI_API_KEY=your_openai_api_key

# Atlas flight SEARCH only. No transaction endpoint is configured by SCOUT.
# Set this to the approved environment-specific search base before cutover.
ATLAS_SEARCH_BASE_URL=your_atlas_search_base_url
ATLAS_CLIENT_ID=your_atlas_client_id
ATLAS_CLIENT_SECRET=your_atlas_client_secret
